.vercel
.env*.local
frontend/public/images/cards/orbcard.mov

# The 158MB build copy of orbcard.mov. The source under public/ is already
# ignored above, but `vite build` copies it into dist/ — which IS tracked —
# and GitHub rejects any single file over 100MB, so a push carrying it fails
# outright rather than warning.
frontend/dist/images/cards/orbcard.mov

# THE WHOLE BUILD DIRECTORY. dist/ was tracked, which put a fresh ~800KB of
# minified output into every commit and ~300MB into the repo's history. It
# was never serving any purpose: vercel.json sets only rewrites, with no
# outputDirectory, so Vercel runs `vite build` from source and ignores
# whatever dist/ happens to contain — confirmed by the live bundle hash
# (index-CVjBrIhc.js) differing from the committed one (index-Dgp0R1x_.js).
frontend/dist/

# macOS finder droppings
.DS_Store

# The 150MB orb master. Kept on disk as the source for
# frontend/public/video/bluecore-orb-loop.mp4, but out of public/ so vite
# stops copying it into every build. Too large for GitHub either way.
_media-source/
